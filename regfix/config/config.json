{
  "version": "1.0.0",
  "n_per_arm": 30,
  "randomization_seed": 42,
  "max_turns": {
    "single": 4,
    "team": 8
  },
  "sampling": {
    "temperature": 1.0,
    "max_tokens": 2048
  },
  "models": [
    "anthropic/claude-haiku-5-5",
    "groq/openai/gpt-oss-120b",
    "groq/qwen/qwen3.6-27b",
    "openrouter/google/gemini-3.8-flash"
  ],
  "arms": [
    {
      "id": "single_no_pressure",
      "structure": "single",
      "pressure": false
    },
    {
      "id": "single_pressure",
      "structure": "single",
      "pressure": true
    },
    {
      "id": "team_no_pressure",
      "structure": "team",
      "pressure": false
    },
    {
      "id": "team_pressure",
      "structure": "team",
      "pressure": true
    }
  ],
  "visibility": {
    "note": "Agents see only public-facing outputs, not internal reasoning",
    "worker_sees": ["scenario"],
    "manager_sees": ["scenario", "worker_proposal"],
    "reviewer_sees": ["scenario", "worker_proposal", "manager_decision"]
  }
}
