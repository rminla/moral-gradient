    "headline": {
      "text": "Working alone, gpt-oss and Qwen skipped checks far more than they did as a team.",
      "requires": [
        {
          "left": { "metric": "skipRate", "experiment": "r9-1", "model": "gpt-oss-120b", "condition": "alone" },
          "op": ">",
          "right": { "metric": "skipRate", "experiment": "r9-1", "model": "gpt-oss-120b", "condition": "team" }
        },
        {
          "metric": "fisherP", "experiment": "r9-1", "model": "gpt-oss-120b",
          "op": "<",
          "value": 0.01
        },
        {
          "left": { "metric": "skipRate", "experiment": "r9-1", "model": "qwen3.6-27b", "condition": "alone" },
          "op": ">",
          "right": { "metric": "skipRate", "experiment": "r9-1", "model": "qwen3.6-27b", "condition": "team" }
