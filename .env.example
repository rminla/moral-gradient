# ---- Branding ----
NEXT_PUBLIC_SITE_NAME="Moral Gradient"
# Local dev uses localhost; production is https://moralgradient.org (set in Vercel env vars).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database (libSQL / SQLite). Local file in dev; Turso (free tier) in production ----
DATABASE_URL=file:./data/site.db
DATABASE_AUTH_TOKEN=

# ---- Results + cost ledger ----
# Results bundle folder (schema v1: public/index.json, public/families, public/runs, donor_only/). The site adapts it via scripts/build_site_bundle.py; falls back to data/sample-bundle.json (EXAMPLE DATA).
RESULTS_DIR=../results
# Pilot cost ledger (SQLite). Only readable where the pilot runs (the box). In production, push via /api/ingest.
LEDGER_PATH=../pilot/data/ledger.sqlite
# Shared secret for POST /api/ingest (bundle, traces, spend) from the box.
INGEST_TOKEN=

# ---- Payments (Stripe Checkout). Leave blank for MOCK mode (no real charges) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Auth (magic link) ----
SESSION_SECRET=change-me-to-a-long-random-string
# Resend (free tier) for magic-link email. Blank = dev mode: link is shown on screen, never logged.
RESEND_API_KEY=
EMAIL_FROM="Moral Gradient <hello@moralgradient.org>"
# Comma-separated emails that see the admin page
ADMIN_EMAILS=

# ---- Auto-launch of funded suites ----
# AUTO_LAUNCH=1 launches immediately when a milestone is fully funded (Raphael's request, 2026-10-29).
AUTO_LAUNCH=1
# dryrun (default; records the job, spends nothing) | command (spawn locally, box only) | webhook (POST to a runner)
JOB_RUNNER_MODE=dryrun
# For mode=command. {model} {suite} {budget} {milestone} are substituted. The runner MUST enforce --budget as a hard cap.
JOB_RUNNER_CMD="python3 ../pilot/run_suite.py --model {model} --suite {suite} --budget {budget} --milestone {milestone}"
# For mode=webhook (e.g. a GitHub Actions workflow_dispatch proxy or a runner on the box)
JOB_WEBHOOK_URL=
JOB_WEBHOOK_TOKEN=

# Preview-only latches. Keep both 0 (or unset) in production.
# ALLOW_MOCK_PAYMENTS=1 enables the fake checkout when STRIPE_SECRET_KEY is empty.
# ALLOW_DEV_LOGIN=1 shows sign-in links on screen when RESEND_API_KEY is empty (anyone could sign in as anyone).
ALLOW_MOCK_PAYMENTS=0
ALLOW_DEV_LOGIN=0
